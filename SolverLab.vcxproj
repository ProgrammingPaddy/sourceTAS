<?xml version="1.0" encoding="utf-8"?>
<!-- SolverLab: console harness for the engine-independent solver core
     (Source/Solver). Builds with the same toolset and optimization flags as
     Basehook.vcxproj so float behavior matches when the DLL embeds the core.
     Build:
       MSBuild.exe SolverLab.vcxproj -p:Configuration=Release -p:Platform=x64
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{E1D0A9C4-5B7F-4A63-9C2D-8F1B6A0D4E21}</ProjectGuid>
    <RootNamespace>SolverLab</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <OutDir>$(ProjectDir)Output\SolverLab\</OutDir>
    <IntDir>$(ProjectDir)Output\SolverLab\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>WIN32;WIN32_LEAN_AND_MEAN;NDEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Source\Solver\SolverWorld.cpp" />
    <ClCompile Include="Source\Solver\SolverMove.cpp" />
    <ClCompile Include="Source\Solver\SolverTape.cpp" />
    <ClCompile Include="Source\Solver\SolverParams.cpp" />
    <ClCompile Include="Source\Solver\SolverKnots.cpp" />
    <ClCompile Include="Source\Solver\SolverExplore.cpp" />
    <ClCompile Include="Source\Solver\SolverOptimize.cpp" />
    <ClCompile Include="Source\Solver\SolverSmooth.cpp" />
    <ClCompile Include="Source\Solver\SolverChain.cpp" />
    <ClCompile Include="Source\Solver\SolverLab.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Source\Solver\SolverMath.h" />
    <ClInclude Include="Source\Solver\SolverWorld.h" />
    <ClInclude Include="Source\Solver\SolverMove.h" />
    <ClInclude Include="Source\Solver\SolverTape.h" />
    <ClInclude Include="Source\Solver\SolverParams.h" />
    <ClInclude Include="Source\Solver\SolverKnots.h" />
    <ClInclude Include="Source\Solver\SolverExplore.h" />
    <ClInclude Include="Source\Solver\SolverOptimize.h" />
    <ClInclude Include="Source\Solver\SolverSmooth.h" />
    <ClInclude Include="Source\Solver\SolverChain.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
